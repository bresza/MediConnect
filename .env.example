# MediConnect - variaveis de ambiente
# Copie este arquivo para .env e preencha os valores do seu projeto Supabase.

VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon

# ── Assistente (ChatGPT/OpenAI) ──────────────────────────────────
# A chave da OpenAI NAO vai no front. Ela e armazenada como secret do
# projeto Supabase e usada pela Edge Function `ai-chat`:
#
#   supabase secrets set OPENAI_API_KEY=sk-...
#   supabase functions deploy ai-chat
#
# As variaveis abaixo sao apenas defaults de UI (opcionais).
VITE_OPENAI_MODEL=gpt-4o-mini
VITE_OPENAI_MAX_TOKENS=600
